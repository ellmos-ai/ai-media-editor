{
  "schema": "ellmos.module.v2",
  "id": "ai-media-editor",
  "display_name": "ai-media-editor",
  "version": "0.3.0",
  "description": "Local-first AI-assisted audio/video preparation with optional remote STT and generative workflows.",
  "package": null,
  "entrypoints": {
    "cli": "python editor.py",
    "workflow": "CLAUDE.md"
  },
  "category": "domains",
  "kind": "stack-candidate",
  "status": "development",
  "visibility": "public",
  "provides": [
    "domain.media.editing",
    "workflow.media.pipeline"
  ],
  "requires": [],
  "optional": [
    "tool.stt",
    "tool.video",
    "tool.hyperframes",
    "clip-storyboard-director"
  ],
  "conflicts": [],
  "surfaces": [
    "cli",
    "workflow"
  ],
  "state": {
    "ownership": "external",
    "location": "project"
  },
  "boundaries": {
    "network": "optional",
    "data": "sensitive",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/ellmos-ai/ai-media-editor.git"
  },
  "adapters": [
    {
      "type": "seam",
      "id": "ocean-owned-process.v1",
      "target": "open-ocean",
      "status": "contract",
      "role": "executor for pipeline 3b (video-render)",
      "note": "ai_media_editor/ocean_worker.py implements the OwnedProcessExecutor worker protocol (open-ocean PR #70); verified with fixture admission by tests/e2e/ocean_gate.py on 2026-11-14. Production admission needs a reviewed workload profile."
    }
  ],
  "roles": [
    {
      "id": "media-creator",
      "label": "MEDIA-CREATOR",
      "prompt": "CLAUDE.md",
      "request": "Start as MEDIA-CREATOR. Produce deterministic audio, video, and HyperFrames media compositions.",
      "modes": [],
      "providers": [
        "claude",
        "codex",
        "agy",
        "kimi"
      ]
    }
  ]
}
